[
  cc_library(
    name = name,
    hdrs = glob(["lib/%s.framework/Headers/**/*" % name]),
      # glob(["lib/%s.framework/Headers/**/6.11.1/%s/**/*.h" % (name, name)]),
    additional_linker_inputs = [":Frameworks"],
    linkopts = [
      "-framework %s" % name,
      "-F $(location :Frameworks)",
      "-rpath $(location :Frameworks)",
    ],
    include_prefix = name,
    strip_include_prefix = "lib/%s.framework/Headers" % name,
    includes = [
      #"lib/%s.framework/" % name, 
      "lib/%s.framework/Headers" % name, 
      "lib/%s.framework/Headers/6.11.1" % name, 
      "lib/%s.framework/Headers/6.11.1/%s" % (name, name), 
      "lib/%s.framework/Headers/6.11.1/%s/private" % (name, name), 
    ],
  )
  for name, _ in modules
]

cc_library(
  name = "QtQmlIntegration",
  hdrs = glob(["include/QtQmlIntegration/**/*.h"]),
  additional_linker_inputs = [":lib"],
  linkopts = [
    
  ],
  strip_include_prefix = "include",
  includes = ["include"],
)

exports_files(["lib", "Frameworks"])

# subdirectory(
#   name = "Frameworks",
#   parent = ":files",
#   path = "Frameworks"
# )

native_binary(
  name = "rcc",
  src = "share/qt/libexec/rcc",
  visibility = ["//visibility:public"],
)

filegroup(
  name = "shared_libraries",
  srcs = [],
  visibility = ["//visibility:public"]
)

cc_library(
  name = "qt",
  deps = [ name for name, _ in modules ] + ["QtQmlIntegration"],
  visibility = ["//visibility:public"],
  target_compatible_with = [
    "@platforms//cpu:aarch64",
    "@platforms//os:osx",
  ],
)

directory(
  name = "files",
  srcs = glob(["**"]),
  visibility = ["//visibility:public"],
)

subdirectory(
  name = "include",
  parent = ":files",
  path = "include",
  visibility = ["//visibility:public"],
)

subdirectory(
  name = "bin",
  parent = ":files",
  path = "bin",
  visibility = ["//visibility:public"],
)

# subdirectory(
#   name = "lib",
#   parent = ":files",
#   path = "lib",
#   visibility = ["//visibility:public"],
# )

subdirectory(
  name = "libexec",
  parent = ":files",
  path = "libexec",
  visibility = ["//visibility:public"],
)

subdirectory(
  name = "plugins",
  parent = ":files",
  path = "plugins",
  visibility = ["//visibility:public"],
)

subdirectory(
  name = "qml",
  parent = ":files",
  path = "share/qt6/qml",
  visibility = ["//visibility:public"],
)
