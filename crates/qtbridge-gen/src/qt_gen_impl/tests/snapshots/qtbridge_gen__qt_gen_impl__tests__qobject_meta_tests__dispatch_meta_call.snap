impl qtbridge::qtbridge_runtime::DispatchMetaCall for SomeStruct {
    fn invoke_slot(&mut self, slot_id: u32, inputs: &[*const u8], outputs: &[*mut u8]) {
        match slot_id {
            1u32 => self.slot_one(),
            2u32 => {
                let arg_0_ref = unsafe {
                    inputs[0usize]
                        .cast::<qtbridge::qtbridge_type_lib::QString>()
                        .as_ref()
                }
                .expect("Argument reference is null");
                let arg_0_var: <str as ToOwned>::Owned = arg_0_ref.into();
                self.slot_two(&arg_0_var)
            }
            _ => panic!("Unhandled slot id {slot_id}"),
        }
    }
    fn read_property(&self, prop_id: u32) -> qtbridge::qtbridge_type_lib::QVariant {
        match prop_id {
            1u32 => (&self.first_value).into(),
            2u32 => (&self.second_value).into(),
            3u32 => (&self.third_value).into(),
            _ => panic!("Unhandled property id {prop_id}"),
        }
    }
    fn write_property(&mut self, prop_id: u32, value: &qtbridge::qtbridge_type_lib::QVariant) {
        match prop_id {
            1u32 => {
                let Ok(value) = value.try_into() else {
                    panic!(
                        "Failed to convert value '{}' to type '{}' in qproperty '{}'",
                        value.to_string(),
                        std::any::type_name_of_val(&self.first_value),
                        "this_value"
                    );
                };
                if self.first_value != value {
                    self.first_value = value;
                    self.this_value_changed();
                }
            }
            2u32 => {
                let Ok(value) = value.try_into() else {
                    panic!(
                        "Failed to convert value '{}' to type '{}' in qproperty '{}'",
                        value.to_string(),
                        std::any::type_name_of_val(&self.second_value),
                        "otherValue"
                    );
                };
                self.second_value = value;
            }
            3u32 => {
                let Ok(value) = value.try_into() else {
                    panic!(
                        "Failed to convert value '{}' to type '{}' in qproperty '{}'",
                        value.to_string(),
                        std::any::type_name_of_val(&self.third_value),
                        "thirdValue"
                    );
                };
                self.third_value = value;
            }
            _ => panic!("Unhandled property id {prop_id}"),
        }
    }
}
