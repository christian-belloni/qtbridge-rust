impl qtbridge::qtbridge_runtime::QMetaInfo for SomeStruct {
    fn register_meta(
        mut meta_obj: std::pin::Pin<&mut qtbridge::qtbridge_runtime::DynamicMetaObjectBuilder>,
    ) {
        use qtbridge::qtbridge_runtime::get_meta_type_of_fn_return_value;
        use qtbridge::qtbridge_type_lib;
        use qtbridge_type_lib::{QMetaType, QMetaTypeGet};
        meta_obj.as_mut().register_signal(
            "thisValueChanged",
            &[qtbridge_type_lib::QString::get_qmetatype()],
        );
        meta_obj
            .as_mut()
            .register_signal("otherValueChanged", &[f32::get_qmetatype()]);
        meta_obj.as_mut().register_signal(
            "thisStringValueChangedByRef",
            &[qtbridge_type_lib::QString::get_qmetatype()],
        );
        meta_obj.as_mut().register_signal(
            "thatStringValueChangedByValue",
            &[qtbridge_type_lib::QString::get_qmetatype()],
        );
        meta_obj.as_mut().register_slot(
            "onThatValueChanged",
            1u32,
            &[qtbridge_type_lib::QString::get_qmetatype()],
            &QMetaType::default(),
            qtbridge::qtbridge_runtime::dynamicmetaobjectbuilder::Mutability::Mutable,
        );
        meta_obj.as_mut().register_property(
            "this_value",
            1u32,
            &(qtbridge_type_lib::QString::get_qmetatype()),
            false,
            "thisValueChanged",
        );
        meta_obj
            .as_mut()
            .add_class_info("DefaultProperty", "this_value");
        meta_obj.as_mut().register_property(
            "otherValue",
            2u32,
            &(get_meta_type_of_fn_return_value(|this: &Self| &this.otherValueVar)),
            false,
            "otherValueChanged",
        );
        meta_obj.as_mut().add_class_info("Author", "The Qt Company");
        meta_obj.as_mut().end_meta_registration();
    }
    fn get_static_meta_object() -> &'static qtbridge::qtbridge_type_lib::QMetaObject {
        <Self as qtbridge::qtbridge_runtime::QObjectHolder>::get_static_meta_object()
    }
    fn get_shared_dynamic_meta_object_data(
    ) -> &'static qtbridge::qtbridge_runtime::DynamicMetaObjectData {
        use std::sync::OnceLock;
        thread_local! { static DYNAMIC_META_OBJECT : OnceLock < & 'static qtbridge :: qtbridge_runtime :: DynamicMetaObjectData > = OnceLock :: new () ; }
        DYNAMIC_META_OBJECT.with(|cell| {
            *cell.get_or_init(|| {
                let ptr = Self::create_dynamic_meta_object_data_for_type();
                unsafe { ptr.as_ref() }.unwrap()
            })
        })
    }
}
